# Copie para .env.local e preencha com os dados do projeto no Supabase
# (Project Settings › API Keys).

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Chave secreta: só no servidor. Usada para convidar usuários por e-mail.
# NUNCA coloque NEXT_PUBLIC_ na frente dela.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Endereço público do sistema (links dos convites por e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "teste" mostra a faixa de ambiente de teste no topo (dados fictícios).
NEXT_PUBLIC_AMBIENTE=
